        }
      }
    },
    "/analyze": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Post Analyze",
        "description": "Summarise the window's metrics with the configured AI provider.\n\nThe server builds the input itself from aggregates; clients send only the window.",
        "operationId": "post_analyze_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/AnalysisRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many analyses right now; try again later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The AI provider could not produce an analysis; try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "AI analysis is not configured on this server. Also returned when the database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "headline": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Headline"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Observations"
          },
          "hypotheses": {
            "items": {
              "$ref": "#/components/schemas/Hypothesis"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Hypotheses"
          },
          "next_steps": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 3,
            "title": "Next Steps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "headline",
          "observations",
          "hypotheses",
          "next_steps"
        ],
        "title": "Analysis"
      },
      "AnalysisRequest": {
        "properties": {
          "window_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1440.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalysisRequest"
      },
      "AnalysisResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_data"
            ],
            "title": "Status"
          },
          "window": {
            "$ref": "#/components/schemas/AnalysisWindow"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Analysis"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "window",
          "generated_at",
          "provider",
          "model",
          "cached",
          "analysis"
        ],
        "title": "AnalysisResponse",
        "description": "One shape for both outcomes, so clients handle a single type.\n\nWith too little traffic the status is \"no_data\" and provider, model and analysis are\nnull; no provider was called."
      },
      "AnalysisWindow": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "window_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Window Minutes"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "window_minutes"
        ],
        "title": "AnalysisWindow"
      },
      "CreateOrderRequest": {
        "properties": {
          "user_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "User Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "items"
        ],
        "title": "CreateOrderRequest"
      },
      "CreatedOrder": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "status",
          "total",
          "items"
        ],
        "title": "CreatedOrder"
      },
      "EndpointMetrics": {
        "properties": {
          "total_requests": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Requests"
          },
          "server_errors": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Server Errors"
          },
          "client_errors": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Client Errors"
          },
          "error_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Rate"
          },
          "avg_latency_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Latency Ms"
          },
          "p95_latency_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "P95 Latency Ms"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "endpoint": {
            "type": "string",
            "title": "Endpoint"
          }
        },
        "type": "object",
        "required": [
          "total_requests",
          "server_errors",
          "client_errors",
          "error_rate",
          "avg_latency_ms",
          "p95_latency_ms",
          "method",
          "endpoint"
        ],
        "title": "EndpointMetrics"
      },
      "EndpointTrend": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method"
          },
          "endpoint": {
            "type": "string",
            "title": "Endpoint"
          },
          "buckets": {
            "items": {
              "$ref": "#/components/schemas/TrendBucket"
            },
            "type": "array",
            "title": "Buckets"
          }
        },
        "type": "object",
        "required": [
          "method",
          "endpoint",
          "buckets"
        ],
        "title": "EndpointTrend"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hypothesis": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Text"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium"
            ],
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "confidence"
        ],
        "title": "Hypothesis"
      },
      "LatencyTrend": {
        "properties": {
          "overall": {
            "items": {
              "$ref": "#/components/schemas/TrendBucket"
            },
            "type": "array",
            "title": "Overall"
          },
          "by_endpoint": {
            "items": {
              "$ref": "#/components/schemas/EndpointTrend"
            },
            "type": "array",
            "title": "By Endpoint"
          }
        },
        "type": "object",
        "required": [
          "overall",
          "by_endpoint"
        ],
        "title": "LatencyTrend"
      },
      "MetricsResponse": {
        "properties": {
          "window": {
            "$ref": "#/components/schemas/MetricsWindow"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "endpoints": {
            "items": {
              "$ref": "#/components/schemas/EndpointMetrics"
            },
            "type": "array",
            "title": "Endpoints"
          },
          "status_codes": {
            "items": {
              "$ref": "#/components/schemas/StatusCodeCount"
            },
            "type": "array",
            "title": "Status Codes"
          },
          "latency_trend": {
            "$ref": "#/components/schemas/LatencyTrend"
          },
          "recent_requests": {
            "items": {
              "$ref": "#/components/schemas/RecentRequest"
            },
            "type": "array",
            "title": "Recent Requests"
          }
        },
        "type": "object",
        "required": [
          "window",
          "summary",
          "endpoints",
          "status_codes",
          "latency_trend",
          "recent_requests"
        ],
        "title": "MetricsResponse"
      },
      "MetricsWindow": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "window_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Window Minutes"
          },
          "bucket_minutes": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Bucket Minutes"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "window_minutes",
          "bucket_minutes"
        ],
        "title": "MetricsWindow"
      },
      "Observation": {
        "properties": {
          "endpoint": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Endpoint"
          },
          "metric": {
            "type": "string",
            "enum": [
              "total_requests",
              "requests_per_minute",
              "error_rate",
              "client_errors",
              "avg_latency_ms",
              "p95_latency_ms"
            ],
            "title": "Metric"
          },
          "text": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "endpoint",
          "metric",
          "text"
        ],
        "title": "Observation"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "total",
          "status"
        ],
        "title": "Order"
      },
      "OrderItem": {
        "properties": {
