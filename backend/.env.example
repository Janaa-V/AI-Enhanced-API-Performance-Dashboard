# Copy to .env locally. Never place real credentials in this template.
APP_NAME="API Performance Dashboard"
ENVIRONMENT=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=performance_dashboard
# Database used by integration tests. It is emptied on every run, so it must end in _test.
TEST_DB_NAME=performance_dashboard_test
DB_USER=dashboard
# Use the same password as POSTGRES_PASSWORD in Documents/os-services/.env.
DB_PASSWORD=
CORS_ORIGINS=["http://localhost:5173"]
METRICS_WINDOW_MINUTES=60

# Simulated demo traffic. Both are multipliers: 1 is normal, 0 turns the effect off.
SIMULATION_LATENCY_SCALE=1
SIMULATION_FAILURE_SCALE=1
# Demo only: make one endpoint slow and flaky (users, products, orders, search, reports,
# orders_create). Leave unset for normal behaviour.
# SIMULATION_DEGRADED_ENDPOINT=reports

# AI provider: disabled, fake (no key; a fixed, labelled answer for local demos; refused in
# production), groq or gemini (both need AI_API_KEY). Empty AI_MODEL uses the provider's default.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
