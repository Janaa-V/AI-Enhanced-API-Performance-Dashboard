# Copy to .env locally. Never place real credentials in this template.
APP_NAME="API Performance Dashboard"
ENVIRONMENT=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=performance_dashboard
DB_USER=dashboard
# Use the same password as POSTGRES_PASSWORD in Documents/os-services/.env.
DB_PASSWORD=
CORS_ORIGINS=["http://localhost:5173"]
METRICS_WINDOW_MINUTES=60

# AI remains disabled until the provider integration is implemented.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
